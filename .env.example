# ==========================================
# Smart Creator AI — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to GitHub.
# ==========================================

# Server
PORT=5000

# --- Text / Chat provider (e.g. Google Gemini, OpenAI, Anthropic) ---
AI_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Image generation provider ---
IMAGE_PROVIDER=none
IMAGE_API_KEY=

# --- Video generation provider ---
VIDEO_PROVIDER=none
VIDEO_API_KEY=
